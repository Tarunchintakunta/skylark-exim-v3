{
  "name": "skylark-exim-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --port 4173 --strictPort",
    "assets": "scripts/fetch-sources.sh && scripts/encode-clips.sh && scripts/make-posters.sh && scripts/optimize-glb.sh",
    "test": "playwright test tests/smoke.spec.ts",
    "test:scroll": "playwright test tests/scroll-perf.spec.ts",
    "test:weight": "playwright test tests/weight.spec.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "lh": "lhci autorun",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "gsap": "3.15",
    "lenis": "1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vercel/node": "^23.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
