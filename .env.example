# RFQ email (all optional). Without RESEND_API_KEY + RFQ_FROM the form opens the visitor's email app pre-filled instead.
RESEND_API_KEY=
# Where quote requests go
RFQ_TO=info@skylarkexim.com
# Sender on a domain verified in Resend, e.g. quotes@skylarkexim.com
RFQ_FROM=
# /order: Google Apps Script web app URL (docs/ORDER_SHEET_APPS_SCRIPT.js) that appends a sheet row and sends a Gmail alert
VITE_ORDER_WEBHOOK_URL=
